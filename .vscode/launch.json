{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "msedge",
            "request": "launch",
            "name": "Open entry.html",
            "file": "${workspaceFolder}/client/entry.html"
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "Open onboarding.html",
            "file": "${workspaceFolder}/onboarding.html"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Server",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--loader", "ts-node/esm"],
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}/server/server.js",
            "cwd": "${workspaceFolder}/server",
            "envFile": "${workspaceFolder}/server/.env"
        }
    ],
    "compounds": [
        {
            "name": "Full App (Server + Entry)",
            "configurations": ["Launch Server", "Open entry.html"]
        }
    ]
}